+class Words(unittest.TestCase):
+    def test_the_bot_start_text_and_end_text(self):
+        c = pb.generate_bot(63, 3, 2, rng=random.Random(0))
+        foe = pr.build_dummy("fodder", "Bot")
+        player = pr.build_trainee(USER)
