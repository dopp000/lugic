+            for p in c.passives:
+                self.assertIsNone(parse_passive(p["lines"])[1], p)
+
+    def test_a_manual_bot_has_no_skills_or_passives_and_keeps_points_back(self):
+        for level, seed, c in self.bots(skills=False, passives=False):
